# ─────────────────────────────────────────────────────────────────
# KubeNexus Backend – Environment Configuration
# ─────────────────────────────────────────────────────────────────

# ── DATABASE ──────────────────────────────────────────────────────
# Leave blank to automatically use a local SQLite file (kubenexus.db).
# For production (Supabase PostgreSQL), use the Transaction Pooler URI:
#   DATABASE_URL=postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres
DATABASE_URL=

# ── CORS ALLOWED ORIGINS ──────────────────────────────────────────
# Comma-separated list of additional frontend origins allowed to call this API:
# Example: ALLOWED_ORIGINS=https://kube-nexus-navy.vercel.app,http://localhost:3000
ALLOWED_ORIGINS=https://kube-nexus-navy.vercel.app

# ── PROMETHEUS ────────────────────────────────────────────────────
PROMETHEUS_URL=http://localhost:9090
