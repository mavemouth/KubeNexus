# ====================================================================
# KubeNexus Backend Environment Configuration (Supabase PostgreSQL)
# ====================================================================

# Supabase PostgreSQL Connection String (URI)
# In Supabase: Project Settings -> Database -> Connection string -> URI
# Replace [YOUR-PASSWORD] with the database password set when creating the project.
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres

# (Optional) Supabase Project URL & Public Anon Key
SUPABASE_URL=https://[PROJECT-REF].supabase.co
SUPABASE_ANON_KEY=[YOUR-ANON-KEY]
