# ─────────────────────────────────────────────────────────────────
# KuberNexus Backend – Environment Configuration
# Copy this file to .env and fill in your values.
# ─────────────────────────────────────────────────────────────────

# ── DATABASE ──────────────────────────────────────────────────────
# Leave blank to automatically use a local SQLite file (kubenexus.db).
# For production, set a PostgreSQL / Supabase connection string, e.g.:
#   DATABASE_URL=postgresql://user:password@host:5432/dbname
DATABASE_URL=

# ── PROMETHEUS ────────────────────────────────────────────────────
# Default Prometheus URL used for metric collection when a cluster
# does not specify its own URL.
# When running with Minikube + kube-prometheus-stack:
#   kubectl port-forward -n monitoring svc/kube-prometheus-kube-prome-prometheus 9090:9090
PROMETHEUS_URL=http://localhost:9090

# ── SUPABASE (optional, legacy) ───────────────────────────────────
# Only needed if you switch back to Supabase.
SUPABASE_URL=
SUPABASE_ANON_KEY=
